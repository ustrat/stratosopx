{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Assets-only Worker: serves the static Next.js export in ./out.
  "name": "stratosopx",
  "compatibility_date": "2026-10-01",
  // Serve only on the custom domain; keep the public workers.dev and preview URLs off.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
