{
  "name": "@stratosopx/product",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply stratosopx --local",
    "db:migrate:remote": "wrangler d1 migrations apply stratosopx --remote",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@stratosopx/core": "^0.1.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  }
}
