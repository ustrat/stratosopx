{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // StratosOpx product: React SPA (static assets) + Hono API in one Worker.
  "name": "stratosopx-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.stratosopx.com", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stratosopx",
      "database_id": "d3deea5b-6f82-4458-b251-87f2374b01c2",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "access": identity from Cloudflare Access. "dev": local only, see .dev.vars.
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "stratosopx.cloudflareaccess.com",
    "ACCESS_AUD": "cc807d7f815cf5696b3b018f20b648d8153f51e679e90aba4d223e18e567ad8b"
  },
  "observability": { "enabled": true }
}
