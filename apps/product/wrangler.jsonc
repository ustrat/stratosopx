{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // StratosOpx product: React SPA (static assets) + Hono API in one Worker.
  "name": "stratosopx-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.stratosopx.com", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stratosopx",
      // Replaced with the real ID after `wrangler d1 create stratosopx`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "access": identity from Cloudflare Access. "dev": local only, see .dev.vars.
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
